# Copy this file to .env for local development. Never commit the real .env.
APP_ENV=development

# Use an absolute persistent path in production, for example /var/data/marketsim.db.
MARKETSIM_DB_PATH=./marketsim.db

# Required to create a new company ADMIN. Use a long random value (32+ characters).
ADMIN_BOOTSTRAP_CODE=replace-with-a-long-random-bootstrap-code

# AI provider configuration
AI_PROVIDER=groq
GROQ_API_KEY=replace-with-your-own-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FORCE_8B=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Authentication/session security
SESSION_COOKIE=marketsim_session
SESSION_MAX_AGE_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=43200
# Set true behind HTTPS in production. APP_ENV=production also enables it by default.
SESSION_COOKIE_SECURE=false

# Resource limits
MAX_UPLOAD_BYTES=52428800
MAX_CONCURRENT_REQUESTS=8
MAX_CONCURRENT_AI=8
REQUEST_TIMEOUT_SEC=120
STAGED_SESSION_TTL_SECONDS=14400
IN_MEMORY_RESULT_TTL_SECONDS=3600
MAX_IN_MEMORY_JOBS=200
