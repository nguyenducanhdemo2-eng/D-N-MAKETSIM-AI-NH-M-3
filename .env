# Copy this file to .env for local development. Never commit the real .env.
APP_ENV=development

# Use an absolute persistent path in production, for example /var/data/marketsim.db.
MARKETSIM_DB_PATH=./marketsim.db

# AI provider configuration
AI_PROVIDER=groq
GROQ_FORCE_8B=false
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Authentication/session security
SESSION_COOKIE=marketsim_session
SESSION_MAX_AGE_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=43200
# Set true behind HTTPS in production. APP_ENV=production also enables it by default.
SESSION_COOKIE_SECURE=false

# Resource limits
MAX_UPLOAD_BYTES=52428800
MAX_CONCURRENT_REQUESTS=8
MAX_CONCURRENT_AI=8
REQUEST_TIMEOUT_SEC=120
STAGED_SESSION_TTL_SECONDS=14400
IN_MEMORY_RESULT_TTL_SECONDS=3600
MAX_IN_MEMORY_JOBS=200
